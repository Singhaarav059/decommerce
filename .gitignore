# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/reports

# reference PNGs are regenerated from the .webp originals (sips -s format png)
/assets-src/refs/*.png

# rejected visual experiments (Oct 2026): kept locally, not part of the build
/assets-src/stills/v5/
/assets-src/stills/v5-clay/
/assets-src/style/
/assets-src/style2/
/assets-src/vertex/v5-*.mp4
/assets-src/vertex/v5clay-*.mp4
/assets-src/vertex/v6-*-take*.mp4
/.taste-skill/
# rejected keyframe takes (kept locally for comparison)
/assets-src/stills/v7/**/*-t[0-9].png
